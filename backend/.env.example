# Port the API listens on
PORT=4000
# Folder holding app.sqlite, schema.sql and seed.sql (relative to the backend folder)
DATABASE_DIR=../database
# Origin(s) allowed to call the API directly (comma separated). The Next.js app proxies /api, so this is only needed for direct calls.
CORS_ORIGIN=http://localhost:3000
# Passcode for the clinic admin. Leave empty to keep the admin open (local development only).
ADMIN_TOKEN=seaside-shop
